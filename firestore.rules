rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Workers collection
    match /workers/{workerId} {
      allow read: if true;
      allow write: if isValidId(workerId);
    }

    // Zones and structure collection
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isValidId(zoneId);
    }

    // Connection test collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
